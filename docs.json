{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "MountMonitor Help Center",
  "colors": {
    "primary": "#0099f6",
    "light": "#0099f6",
    "dark": "#0099f6"
  },
  "favicon": {
    "light": "/images/favicon.svg",
    "dark": "/images/favicon.svg"
  },
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Bookings",
        "pages": [
          "bookings"
        ]
      },
      {
        "group": "Payments",
        "pages": [
          "deposits",
          "payments",
          "currency"
        ]
      },
      {
        "group": "Client updates",
        "pages": [
          "sms"
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Open the app",
          "href": "https://app.mountmonitor.com",
          "icon": "layout-dashboard"
        },
        {
          "anchor": "Client Portal",
          "href": "https://portal.mountmonitor.com",
          "icon": "browser"
        },
        {
          "anchor": "Website",
          "href": "https://www.mountmonitor.com",
          "icon": "world"
        }
      ]
    }
  },
  "logo": {
    "light": "/images/mountmonitor-logo.svg",
    "dark": "/images/mountmonitor-logo.svg",
    "href": "https://app.mountmonitor.com"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "mailto:contact@mountmonitor.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mountmonitor.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "website": "https://www.mountmonitor.com"
    }
  },
  "description": "The official MountMonitor Help Center, providing clear guides and practical support for taxidermists and taxidermy businesses using MountMonitor.",
  "icons": {
    "library": "tabler"
  },
  "fonts": {
    "family": "Inter"
  }
}
